# Compiled class file
*.class

# Log file
*.log
*.txt

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle and Java build output
.gradle/
build/
bin/
out/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/

# Keep the Gradle wrapper available to the repository
!**/gradle/wrapper/gradle-wrapper.jar

# Node.js and frontend build output
node_modules/
dist/
dist-ssr/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.local

# IDE and operating system files
.idea/
.vscode/
.DS_Store

# Local environment files
.env
.env.*
!.env.example
!.env.template
